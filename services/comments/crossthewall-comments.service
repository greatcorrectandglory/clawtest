[Unit]
Description=Crossthewall moderated comments
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/ops/clawd/myblog/services/comments/server.py --database /home/ops/.local/state/crossthewall-comments/comments.sqlite3
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
